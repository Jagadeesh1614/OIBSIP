PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/pizza-app

JWT_SECRET=change_this_user_jwt_secret
JWT_ADMIN_SECRET=change_this_admin_jwt_secret

# Nodemailer (Gmail example: use an App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_ALERT_EMAIL=admin@example.com

# Razorpay TEST mode keys (from Razorpay dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Low-stock check: cron schedule + threshold per item type (units)
LOW_STOCK_CRON=*/30 * * * *
LOW_STOCK_THRESHOLD=20

# One-time admin seed credentials (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@pizzaapp.com
SEED_ADMIN_PASSWORD=ChangeMe123
